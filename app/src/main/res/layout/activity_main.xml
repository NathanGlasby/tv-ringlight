<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:baselineAligned="false"
    android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="28dp" android:paddingBottom="28dp">
    <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.40" android:layout_marginEnd="28dp" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="38sp" android:letterSpacing="-0.04" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_tagline" android:textSize="16sp" android:textColor="@color/text_muted" android:layout_marginTop="4dp"/>
        <FrameLayout android:id="@+id/preview_frame" android:layout_width="match_parent" android:layout_height="168dp" android:layout_marginTop="28dp" android:background="@drawable/preview_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/preview_screen" android:textColor="#808A9E" android:textSize="16sp"/>
            <com.ringlight.tv.RingLightView android:id="@+id/light_preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp">
            <View android:id="@+id/status_dot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/status_dot" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/light_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/text_primary" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
        <TextView android:id="@+id/preview_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/text_muted" android:layout_marginTop="4dp"/>
        <Button android:id="@+id/btn_toggle" style="@style/LightButton" android:layout_width="match_parent" android:layout_marginTop="18dp" android:nextFocusDown="@id/btn_shortcuts"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/preview_caption" android:textSize="12sp" android:textColor="@color/text_muted"/>
    </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/settings_scroll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.60" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/panel_background">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_title" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_subtitle" android:textSize="14sp" android:textColor="@color/text_muted" android:layout_marginTop="4dp"/>
        <LinearLayout android:id="@+id/permission_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/permission_background" android:layout_marginTop="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/permission_title" android:textSize="17sp" android:textColor="@color/accent"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/permission_body" android:textSize="14sp" android:textColor="@color/text_muted" android:layout_marginTop="6dp"/>
            <Button android:id="@+id/btn_grant_permission" style="@style/LightButton" android:text="@string/permission_button" android:layout_marginTop="12dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp">
            <TextView style="@style/ControlLabel" android:text="@string/colour_label"/>
            <TextView android:id="@+id/color_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/text_muted"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/color_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
        <TextView style="@style/ControlLabel" android:text="@string/width_label"/>
        <Button android:id="@+id/btn_thickness_minus" style="@style/StepButton" android:text="@string/minus" android:contentDescription="@string/decrease_width" android:nextFocusRight="@id/btn_thickness_plus"/>
        <TextView android:id="@+id/thickness_value" style="@style/StepValue"/>
        <Button android:id="@+id/btn_thickness_plus" style="@style/StepButton" android:text="@string/plus" android:contentDescription="@string/increase_width" android:nextFocusLeft="@id/btn_thickness_minus"/>
    </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
        <TextView style="@style/ControlLabel" android:text="@string/brightness_label"/>
        <Button android:id="@+id/btn_intensity_minus" style="@style/StepButton" android:text="@string/minus" android:contentDescription="@string/decrease_brightness" android:nextFocusRight="@id/btn_intensity_plus"/>
        <TextView android:id="@+id/intensity_value" style="@style/StepValue"/>
        <Button android:id="@+id/btn_intensity_plus" style="@style/StepButton" android:text="@string/plus" android:contentDescription="@string/increase_brightness" android:nextFocusLeft="@id/btn_intensity_minus"/>
    </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="20dp" android:layout_marginBottom="12dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/auto_off_switch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/timer_label" android:textColor="@color/text_primary" android:textSize="17sp" android:padding="4dp" android:background="@drawable/switch_background"/>
        <LinearLayout android:id="@+id/duration_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end|center_vertical" android:layout_marginTop="6dp">
            <Button android:id="@+id/btn_duration_minus" style="@style/StepButton" android:text="@string/minus" android:contentDescription="@string/decrease_duration" android:nextFocusRight="@id/btn_duration_plus"/>
            <TextView android:id="@+id/duration_value" style="@style/StepValue"/>
            <Button android:id="@+id/btn_duration_plus" style="@style/StepButton" android:text="@string/plus" android:contentDescription="@string/increase_duration" android:nextFocusLeft="@id/btn_duration_minus"/>
        </LinearLayout>
        <TextView android:id="@+id/timer_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="13sp" android:layout_marginTop="10dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp">
            <Button android:id="@+id/btn_shortcuts" style="@style/LightButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/remote_button"/>
            <Button android:id="@+id/btn_reset" style="@style/LightButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/reset_button"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/nav_hint" android:textSize="12sp" android:textColor="@color/text_muted"/>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
